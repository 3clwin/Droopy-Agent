# Copy to .env. Never commit the populated file.
# First-run interview writes these (Cursor: AskQuestion; Claude Code / Codex: numbered list).

# Operator first name (results sheet / comments).
QA_REVIEWER_FIRST_NAME=

# Work / Microsoft account for SharePoint, Excel, or similar SSO (full address).
QA_WORK_EMAIL=

# Product / application SSO account for the app under test (full address).
# May be the same as QA_WORK_EMAIL if the client uses one identity.
QA_PRODUCT_EMAIL=

# Tracker: jira | github | azure_devops | linear | other
QA_TRACKER_TYPE=

# Tracker site origin, e.g. https://company.atlassian.net or https://github.com/org/repo
QA_TRACKER_BASE_URL=

# Queue URL: saved filter, project board, label search, or equivalent review list.
QA_QUEUE_URL=

# Live QA / staging application URL (the product under test).
QA_APP_URL=

# Where specs live: figma | mural | confluence | figjam | none
QA_SPECS_SOURCE=

# Optional. Figma REST fallback. Official Figma MCP uses OAuth.
FIGMA_API_TOKEN=

# Optional. Writable Figma file key if a workflow must write to Figma.
FIGMA_TARGET_FILE_KEY=

# Optional. Spreadsheet or results log URL. Leave empty to skip sheet logging.
QA_RESULTS_SHEET_URL=

# Control that commits persisted filters/state. Example only: Load Data
QA_PERSIST_COMMIT_LABEL=Load Data
